# --- Groq (backup when Gemini is unavailable) ---
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_STT_MODEL=whisper-large-v3

# Everything runs without any of these: the advisor falls back to the guided
# bilingual flow, documents are read with on-device Tesseract OCR, and voice
# uses the browser's built-in speech engine.

# Gemini (primary): GenAI advisor (function calling) and document vision
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_EXTRACT_MODEL=gemini-3.5-flash

# Claude: main AI for the advisor chat and KYC documents
ANTHROPIC_API_KEY=
# ADVISOR_MODEL=claude-haiku-5-5
# EXTRACT_MODEL=claude-haiku-5-5
# AI_PROVIDER=deepseek       # move one provider (anthropic, deepseek, gemini, groq) to the front of the chain
# AI_DISABLED=1            # force offline mode, e.g. for judging without network

# DeepSeek: backup for the advisor chat and KYC documents
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_VISION_MODEL=deepseek-flash
# Via Token Harbor (free tier): key thk_live_…, then
# DEEPSEEK_BASE_URL=https://tokenharbor.ai/v1
# DEEPSEEK_MODEL=deepseek-v4.1-flash:free
# DEEPSEEK_VISION_MODEL=deepseek-v4.1-flash:free

# Sarvam AI, voice only: natural Indian-language voice and voice-note transcription
SARVAM_API_KEY=
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_SPEAKER=priya

# Telegram bot (from @BotFather). Local: `npm run telegram` — no public URL needed.
TELEGRAM_BOT_TOKEN=
# Random string; Telegram sends it back on every webhook call
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Cloud API (Meta) — see docs/bots-setup.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; paste the same value in the Meta webhook settings
WHATSAPP_VERIFY_TOKEN=
# App secret from Meta App Dashboard > App settings > Basic (verifies webhook signatures)
WHATSAPP_APP_SECRET=
# WHATSAPP_GRAPH_VERSION=v23.0

# WhatsApp via Twilio sandbox (alternative; /whatsapp simulator works without it)
TWILIO_AUTH_TOKEN=
# Public URL Twilio can reach, used for links inside WhatsApp replies
PUBLIC_BASE_URL=http://localhost:3000

# --- Neon (optional; `neon deploy` fills these in) -------------------------
# Postgres for orders, sessions, consents and audit; without it, a JSON file.
DATABASE_URL=
# Object storage for chat status cards (S3-compatible, private bucket "assets")
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# CARDS_BUCKET=assets

# --- Growth features --------------------------------------------------------
# Bot handles used in win-back and referral links
WHATSAPP_DISPLAY_NUMBER=15551369092
TELEGRAM_BOT_USERNAME=UdyamAdvisorBot
# Stall reminders: on by default on Render; minutes before a reminder
# NUDGES=on|off
# NUDGE_QUOTE_MINUTES=120
# NUDGE_ORDER_MINUTES=120
# Protects GET /api/cron/nudges (send as "Authorization: Bearer <secret>")
CRON_SECRET=

# Sales portal (/sales): session signing key (16+ chars) and the demo staff password
AUTH_SECRET=
STAFF_DEMO_PASSWORD=

# Customer sign-in: one-time codes by SMS or voice call through 2Factor (2factor.in).
TWOFACTOR_API_KEY=
# Order updates to a signed-in owner's WhatsApp outside Meta's 24-hour window need an approved
# template with two body variables: {{1}} order id, {{2}} the update. Leave unset to send only inside the window.
# WHATSAPP_UPDATE_TEMPLATE=order_update
# WHATSAPP_TEMPLATE_LANG=en

# Website (Vercel): the WhatsApp number owners message, and whether to show the "test mode" note
# (Meta's test number only replies to its allowed list). Set TEST_MODE=0 once a real number is connected.
# NEXT_PUBLIC_WHATSAPP_NUMBER=15551369092
# NEXT_PUBLIC_WHATSAPP_TEST_MODE=1

# WhatsApp on an ordinary number (no Meta Business account): the backend links to it as a linked device.
# Turn on, deploy, then a manager links the number once in the staff portal (WhatsApp page).
# WA_LINK=on
